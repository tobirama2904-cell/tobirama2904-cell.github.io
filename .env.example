# ---- LEGION hybrid: everything works with ZERO env. Below = optional upgrades ----
# Admin email allowlist (first admin pubkey is auto-claimed on first login)
NEXT_PUBLIC_ADMIN_EMAILS=tobirama2904@gmail.com
# Agnes AI (also pasteable in-app via "Ключ" button; env = prefilled for everyone)
NEXT_PUBLIC_AGNES_BASE=https://apihub.agnes-ai.com/v1
