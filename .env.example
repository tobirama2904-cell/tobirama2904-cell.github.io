NEXT_PUBLIC_TG_BOT_TOKEN=
NEXT_PUBLIC_TG_STORAGE_CHAT=
# GitHub repo for global banlist publishing (owner/repo; admin pastes token in admin panel)
NEXT_PUBLIC_GH_REPO=
# Cloudflare Web Analytics beacon token (free unlimited stats)
NEXT_PUBLIC_CF_BEACON=
# ---- Legacy (unused in hybrid mode) ----
COPILOTKIT_TELEMETRY_DISABLED=true
